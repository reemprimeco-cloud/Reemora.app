# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://reemora.app

# MyFatoorah
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# Meta Pixel + Conversions API (see TRACKING.md). Leave the pixel id empty
# to disable all tracking: no script, no network calls.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only. Never prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Optional, dev/staging only: routes server events to Events Manager -> Test Events.
META_TEST_EVENT_CODE=
