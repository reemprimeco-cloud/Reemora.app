# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://reemora.app

# UPayments (Kuwait) — sandbox by default; switch base URL to
# https://apiv2api.upayments.com/api/v1 with a live key when going live.
UPAYMENTS_API_KEY=
UPAYMENTS_BASE_URL=https://sandboxapi.upayments.com/api/v1

# Installment reminders — Twilio SMS (or WhatsApp: set TWILIO_FROM=whatsapp:+1415...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Vercel Cron auth for /api/payments/installments/remind (any long random string;
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Admin notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@reemora.app
